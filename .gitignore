```gitignore
# ==========================================
# Dependencies
# ==========================================

node_modules/
jspm_packages/
bower_components/

# ==========================================
# Build outputs
# ==========================================

build/
dist/
out/
.next/
.nuxt/
.output/
.vercel/
.netlify/
storybook-static/

# ==========================================
# Environment variables & secrets
# ==========================================

.env
.env.*
!.env.example
!.env.sample
!.env.template

*.pem
*.key
*.p12
*.pfx

# ==========================================
# Logs
# ==========================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# Testing & Coverage
# ==========================================

coverage/
.nyc_output/
playwright-report/
test-results/
junit.xml

# ==========================================
# Cache & Temporary files
# ==========================================

.cache/
.parcel-cache/
.vite/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo
*.tmp
*.temp
.tmp/
.temp/

# ==========================================
# Package manager
# ==========================================

.npm/
.pnpm-store/

# ==========================================
# Operating Systems
# ==========================================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Thumbs.db:encryptable
Desktop.ini
$RECYCLE.BIN/

# ==========================================
# Editors & IDEs
# ==========================================

.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vs/

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# ==========================================
# Debugging
# ==========================================

*.stackdump
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Local databases & files
# ==========================================

*.sqlite
*.sqlite3
*.db

# ==========================================
# Miscellaneous
# ==========================================

*.orig
*.rej
*.bak
*.old
*.backup
*.patch
*.DS_Store
